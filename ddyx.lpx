#!name=铛铛一下签到
#!desc=铛铛一下自动签到、抽奖。满0.3元自动提现。进入小程序抓取账号，成功后可在编辑参数中填入#关闭抓包。
#!icon=https://raw.githubusercontent.com/yuhuohua/tupiao/refs/heads/main/ddyx.png
#!author=〈ザㄩメ火华
#!arguments-desc=CRON定时设置: 定时执行的时间; 抓取开关: 填 # 禁用捕获

[Argument]
CRON定时设置=input,"0 9 * * *",tag=CRON定时设置, desc=CRON定时设置
抓取开关 = switch, true, true, tag = 抓取Token开关, desc = 默认开启。抓取Token成功后, 可关闭此开关



[Script]
http-request ^https:\/\/vues\.dd1x\.cn\/api\/my\/get_order_first script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/ddyx.js, requires-body=false, tag=铛铛一下抓取Token, enable={抓取开关}

cron {CRON定时设置} script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/ddyx.js, tag=铛铛一下日常任务

[MITM]
hostname = vues.dd1x.cn